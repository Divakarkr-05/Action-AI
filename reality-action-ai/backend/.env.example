# ─────────────────────────────────────────────────────────────
# REALITY → ACTION AI  — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required for auth + history) ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Hugging Face (required for real Gemma 4 integration) ─────
HF_TOKEN=
HF_MODEL=google/gemma-4-31B-it

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Mode ───────────────────────────────────────────────────
# Set to "mock" during development, "gemma" for Hugging Face, or "sarvam" for Sarvam AI
AI_MODE=mock

# ── Sarvam AI ─────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_MODEL=gemma4

# ── File Upload ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
