# ─────────────────────────────────────────────────────────────
# REALITY → ACTION AI — Root Docker Compose Environment File
# Copy this file to .env before running `docker compose up`
# NEVER commit real secrets to Git.
# ─────────────────────────────────────────────────────────────

# ── Backend Configuration ─────────────────────────────────────
AI_MODE=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=gemma4
SARVAM_BASE_URL=https://api.sarvam.ai/v2

# ── Supabase (Cloud-hosted) ───────────────────────────────────
# Backend uses the secret service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Hugging Face (Optional) ───────────────────────────────────
HF_TOKEN=
HF_MODEL=google/gemma-4-31B-it

# ── Security & Limits ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10

# ── Frontend Configuration (Build-time Public Variables) ───────
# Frontend uses ONLY the public anon key. NEVER put service_role here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
VITE_GRAPHQL_URL=http://localhost:8001/graphql
